{{ 'section-hero-banner.css' | asset_url | stylesheet_tag }}

<div class="banner-hero">
  <div class="banner-hero__top-bar">
    <mobile-menu-icon class="banner-hero__mobile-menu-icon desktop-hide">
      <div class="banner-hero_icon-open">
        {% render 'menu-open' %}
      </div>
      <div class="banner-hero_icon-close hidden">
        {% render 'menu-close' %}
      </div>
    </mobile-menu-icon>
    <div class="banner-hero__menu hidden">
      {% if section.settings.top_bar_text != blank %}
        <div class="banner-hero__top-bar-text">
          {{ section.settings.top_bar_text }}
        </div>
      {% endif %}
      <div class="banner-hero__top-bar-button button-animation">
        {% if section.settings.top_button_link != blank %}
          <a class="banner-hero__top-bar-button-anchor" href="{{ section.settings.top_button_link }}">
            {{ section.settings.top_button_text }}
            {% render 'button-arrow' %}
          </a>
        {% endif %}  
      </div> 
    </div>  
    <div class="banner-hero-logo">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo
          | image_url: width: 403
          | image_tag :
            width : section.settings.logo.width,
            height: section.settings.logo.height,
            sizes: 'auto',
            widths: '450',
            fetchpriority: 'high',
            loading: 'eager',
            class: "logo_image"
        }}
      {% endif %}
    </div>
    {% if section.settings.top_bar_text != blank %}
      <div class="banner-hero__top-bar-text mobile-hide">
        {{ section.settings.top_bar_text }}
      </div>
    {% endif %}
    <div class="banner-hero__top-bar-button button-animation mobile-hide">
      {% if section.settings.top_button_link != blank %}
        <a class="banner-hero__top-bar-button-anchor" href="{{ section.settings.top_button_link }}">
          {{ section.settings.top_button_text }}
          {% render 'button-arrow' %}
        </a>
      {% endif %}  
    </div>  
  </div>
  <div class="banner-hero__image">
    <div class="banner-hero__title-text desktop-hide">
      {% if section.settings.title != blank %}
        <div class="banner-hero-content__title">
          {{ section.settings.title }}
        </div>
      {% endif %}
      {% if section.settings.content_text != blank %}
        <div class="banner-hero-content__text">
          {{ section.settings.content_text }}
        </div>
      {% endif %}
    </div>  
    <div class="banner-hero-image">
      {% if section.settings.desktop_image != blank %}
        {{ section.settings.desktop_image
          | image_url: width: 2840
          | image_tag :
          width : section.settings.desktop_image.width,
          height: section.settings.desktop_image.height,
          sizes: '100vw',
          widths: '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680',
          fetchpriority: 'high',
          loading: 'eager',
          class: "desktop_image banner-image mobile-hide"
        }}
      {% else %}
        <div class="mobile-hide">
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>  
      {% endif %}
      {% if section.settings.mobile_image != blank %}
        {{ section.settings.mobile_image
          | image_url: width: 900
          | image_tag :
          width : section.settings.mobile_image.width,
          height: section.settings.mobile_image.height,
          sizes: '100vw',
          widths: '450, 660, 900',
          fetchpriority: 'high',
          loading: 'eager',
          class: "mobile_image banner-image desktop-hide"
        }}
      {% else %}
        <div class="desktop-hide">
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>  
      {% endif %} 
    </div>
    <div class="banner-hero-content">
      {% if section.settings.title != blank %}
        <div class="banner-hero-content__title mobile-hide">
          {{ section.settings.title }}
        </div>
      {% endif %}
      {% if section.settings.content_text != blank %}
        <div class="banner-hero-content__text mobile-hide">
          {{ section.settings.content_text }}
        </div>
      {% endif %}  
      <div class="banner-hero-content__button button-animation">
        {% if section.settings.content_button != blank %}
          <a class="banner-hero-content__button-anchor" href="{{ section.settings.content_button_url }}">
            {{ section.settings.content_button }}
            {% render 'button-arrow' %}
          </a>
        {% endif %}  
      </div>
    </div>  
  </div>
  <div class="banner-hero__footer">
    {% if section.settings.footer_text != blank %}
      <div class="banner-hero__footer-text">
        {{ section.settings.footer_text }}
      </div>
    {% endif %}  
  </div>  
</div>

{{ 'section-hero-banner.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "hero-banner",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Top Bar"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "richtext",
      "id": "top_bar_text",
      "label": "Text"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Button Text"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Image Title"
    },
    {
      "type": "richtext",
      "id": "content_text",
      "label": "Content Text"
    },
    {
      "type": "url",
      "id": "content_button_url",
      "label": "Button Url"
    },
    {
      "type": "text",
      "id": "content_button",
      "label": "Button Text"
    },
    {
      "type": "header",
      "content": "Footer Bar"
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Footer Text"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}